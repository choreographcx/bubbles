        "fields": [
          {
            "element_id": "html-1",
            "type": "html",
            "cols": "12",
            "field_label": "",
            "variations": "<p>Thank you for your interest in adoption.</p><p>We are an all-volunteer animal welfare organization dedicated to rescuing and re-homing stray, neglected, abandoned, abused, and surrendered pets.</p><p><strong>Please note: BPR is not a shelter.</strong> All of our rescues are cared for by team members and are sheltered in personal spaces, foster homes, paid boarding facilities, and vet clinics until a forever home is found.</p><p>The more information you share, the better we can match you with the right companion.</p><p>⚠️ Failing to complete this form fully may result in your application not being considered for adoption of the rescue you are applying for.</p>"
          }
